# DevSuite environment variables — copy to .env and adjust as needed.
# All variables are optional; the defaults below match a standard local install.

# Set to "1" when running DevSuite behind TLS (HTTPS).
# When enabled, the ds_session and ds_csrf cookies are issued with Secure=true.
DEVSUITE_HTTPS=0

# Set to "1" to enable developer mode. This enables the /docs (Swagger UI) and
# /redoc endpoints and turns on uvicorn auto-reload. It does NOT change rate
# limits or logging.
DEVSUITE_DEV=0

# Server-side DevDB encryption password. Leave blank to store the .dsb container
# unencrypted on disk (vault / ssh_profiles blobs are always encrypted
# client-side regardless of this setting).
DEVDB_PASSWORD=

# Host and port the server binds to. Honoured by `python main.py` and by
# start.sh / start.ps1.
HOST=127.0.0.1
PORT=8000
